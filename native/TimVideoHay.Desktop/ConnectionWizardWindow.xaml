<Window x:Class="TimVideoHay.Desktop.ConnectionWizardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kết nối Google" Width="790" Height="780" MinWidth="650" MinHeight="540" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
  <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/></Window.Resources>
  <DockPanel Margin="26">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16"><TextBlock Text="Kết nối Google" FontSize="25" FontWeight="SemiBold"/><UniformGrid Columns="3" Margin="0,12,0,0">
      <Border Padding="10" CornerRadius="5" Margin="0,0,6,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E8EDF4"/><Style.Triggers><DataTrigger Binding="{Binding IsSheet}" Value="True"><Setter Property="Background" Value="#DCEAFF"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="1 · Google Sheets" FontWeight="SemiBold"/></Border>
      <Border Padding="10" CornerRadius="5" Margin="0,0,6,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E8EDF4"/><Style.Triggers><DataTrigger Binding="{Binding IsChannel}" Value="True"><Setter Property="Background" Value="#DCEAFF"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="2 · YouTube" FontWeight="SemiBold"/></Border>
      <Border Padding="10" CornerRadius="5"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E8EDF4"/><Style.Triggers><DataTrigger Binding="{Binding IsConfirm}" Value="True"><Setter Property="Background" Value="#DCEAFF"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="3 · Xác nhận" FontWeight="SemiBold"/></Border>
    </UniformGrid></StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <Border CornerRadius="6" Padding="12" Margin="0,15,0,12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E8EFF8"/><Style.Triggers><DataTrigger Binding="{Binding NoticeIsError}" Value="True"><Setter Property="Background" Value="#FFF0ED"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Notice}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#203044"/><Style.Triggers><DataTrigger Binding="{Binding NoticeIsError}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelCommand}"/><Button Content="Quay lại" Command="{Binding BackCommand}" Visibility="{Binding CanBack, Converter={StaticResource Visible}}"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Tiếp tục" Command="{Binding NextCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Primary}"><Style.Triggers><DataTrigger Binding="{Binding IsConfirm}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Xác nhận kết nối" Style="{StaticResource Primary}" Command="{Binding ConfirmCommand}" Visibility="{Binding IsConfirm, Converter={StaticResource Visible}}"/></StackPanel>
      </Grid>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="{Binding Heading}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18"/>
      <StackPanel Visibility="{Binding IsSheet, Converter={StaticResource Visible}}">
        <TextBlock Text="Chỉ cấp quyền cho bảng bạn chọn. App sẽ kiểm tra tab trước khi lưu kết nối." TextWrapping="Wrap" Foreground="#61748A" Margin="0,0,0,14"/>
        <Button Content="Chọn / đổi bảng Google Sheets" Command="{Binding SelectSheetCommand}" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding SheetName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,14"/>
        <StackPanel Visibility="{Binding HasSheet, Converter={StaticResource Visible}}"><TextBlock Text="Tab video"/><ComboBox ItemsSource="{Binding Tabs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedTab}"/><Button Content="Chọn cột video" Command="{Binding ChooseVideoColumnsCommand}" HorizontalAlignment="Left"/><TextBlock Text="Thông tin: link video · tên video · ngách · loại video. Có thể chọn cột mang tên khác." Foreground="#61748A" TextWrapping="Wrap"/><TextBlock Text="Tab kênh nguồn" Margin="0,12,0,0"/><ComboBox ItemsSource="{Binding Tabs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedSourceTab}"/><Button Content="Chọn cột kênh nguồn" Command="{Binding ChooseChannelColumnsCommand}" HorizontalAlignment="Left"/><TextBlock Text="Link kênh · Tên kênh · Đăng ký · Ngách · Dạng nội dung" TextWrapping="Wrap" Foreground="#61748A"/><TextBlock Text="Tab Kênh block (bắt buộc)" Margin="0,12,0,0"/><ComboBox x:Name="BlockedTabBox" ItemsSource="{Binding Tabs}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBlockedTab}"/><Button Content="Chọn cột Kênh block" Command="{Binding ChooseBlockedColumnsCommand}" HorizontalAlignment="Left"/><TextBlock Text="Cột Link kênh chứa link Douyin /user/… App chỉ đọc tab này. Chọn ba tab khác nhau." TextWrapping="Wrap" Foreground="#61748A"/></StackPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding IsChannel, Converter={StaticResource Visible}}">
        <TextBlock Text="Chọn đúng tài khoản hoặc kênh thương hiệu trên trang Google. App sẽ xác minh kênh được cấp quyền đăng." Foreground="#61748A" TextWrapping="Wrap" Margin="0,0,0,14"/>
        <Button Content="Chọn / đổi kênh YouTube" Command="{Binding SelectChannelCommand}" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding ChannelName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,8"/>
        <Button Content="Mở kênh để kiểm tra" Command="{Binding OpenChannelCommand}" HorizontalAlignment="Left" Visibility="{Binding HasChannel, Converter={StaticResource Visible}}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding IsConfirm, Converter={StaticResource Visible}}">
        <Border Background="White" CornerRadius="6" Padding="18"><StackPanel><TextBlock Text="Bảng Google Sheets" Foreground="#61748A"/><TextBlock Text="{Binding SheetName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14"/><TextBlock Text="Tab video" Foreground="#61748A"/><TextBlock Text="{Binding TabName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14"/><TextBlock Text="Tab kênh nguồn" Foreground="#61748A"/><TextBlock Text="{Binding SourceTabName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14"/><TextBlock Text="Tab Kênh block" Foreground="#61748A"/><TextBlock Text="{Binding BlockedTabName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14"/><TextBlock Text="Kênh YouTube" Foreground="#61748A"/><TextBlock Text="{Binding ChannelName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
        <TextBlock Text="Kết nối này áp dụng cho công việc mới. Công việc cũ giữ nguyên bảng và kênh đã chọn lúc tạo." Foreground="#61748A" TextWrapping="Wrap" Margin="0,16,0,0"/>
      </StackPanel>
    </StackPanel></ScrollViewer>
  </DockPanel>
</Window>
