<UserControl x:Class="TimVideoHay.Desktop.ChecklistFilter" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="0,5,0,8">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <ToggleButton x:Name="FilterToggle" MinHeight="36" Padding="10,7" Background="#EDF2F8" BorderBrush="#CED8E5" ToolTip="{Binding Summary, ElementName=Root}">
   <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="▾" Margin="8,0,0,0"/><ContentPresenter VerticalAlignment="Center"/></DockPanel></Border></ControlTemplate></ToggleButton.Template>
   <TextBlock Text="{Binding Summary, ElementName=Root}" TextTrimming="CharacterEllipsis"/>
  </ToggleButton>
  <Button x:Name="ClearFilter" Grid.Column="1" Content="Bỏ lọc" Command="{Binding ClearCommand, ElementName=Root}" ToolTip="{Binding ClearLabel, ElementName=Root}" Margin="6,0,0,0" Padding="8,5"/>
  <Popup x:Name="ChecklistPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=FilterToggle}" IsOpen="{Binding IsChecked, ElementName=FilterToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
   <Border Background="White" BorderBrush="#CED8E5" BorderThickness="1" CornerRadius="6" Padding="12" MinWidth="220" MaxWidth="320">
    <StackPanel><TextBlock Text="{Binding Hint, ElementName=Root}" Foreground="#61748A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"/>
     <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ChoicesList" ItemsSource="{Binding ItemsSource, ElementName=Root}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,6"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
