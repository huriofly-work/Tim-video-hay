<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TimVideoHay</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <ProjectReference Include="../TimVideoHay.Infrastructure/TimVideoHay.Infrastructure.csproj" />
    <EmbeddedResource Include="$(GoogleOAuthClientPath)" LogicalName="TimVideoHay.GoogleOAuthDesktop.json" Condition="'$(GoogleOAuthClientPath)' != '' and Exists('$(GoogleOAuthClientPath)')" />
  </ItemGroup>
  <Target Name="RequireGoogleClientFile" BeforeTargets="BeforeBuild" Condition="'$(GoogleOAuthClientPath)' != '' and !Exists('$(GoogleOAuthClientPath)')"><Error Text="Google OAuth Desktop configuration file was not found."/></Target>
</Project>
