<Window x:Class="TimVideoHay.Desktop.DeleteJobWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Xóa công việc" Width="680" Height="620" MinWidth="560" MinHeight="360" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True">
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Hủy" IsCancel="True"/><Button x:Name="ConfirmButton" Content="Xác nhận xóa" Click="Confirm" Style="{StaticResource Danger}"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
    <TextBlock Text="Xóa công việc" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="JobName" FontWeight="SemiBold" Margin="0,12,0,8" TextWrapping="Wrap"/>
    <TextBlock Text="Chọn kết quả muốn xóa. Giữ công việc trong lịch sử để có thể thực hiện lại, hoặc chọn xóa lịch sử sau khi chọn hết kết quả hiện có." TextWrapping="Wrap" Foreground="#61748A" Margin="0,0,0,14"/>
    <Button x:Name="CheckResultsButton" Content="Kiểm tra lại kết quả Google" Click="CheckResultsNow" HorizontalAlignment="Left" Margin="0,0,0,8"/>
    <TextBlock x:Name="CheckResultsStatus" TextWrapping="Wrap" Foreground="#61748A" Margin="0,0,0,8"/>
    <CheckBox x:Name="DeleteFolderBox" Content="Xóa thư mục video trên máy và tất cả tệp bên trong" Margin="0,6"/>
    <TextBlock x:Name="FolderPath" TextWrapping="Wrap" Foreground="#61748A" Margin="20,0,0,10"/>
    <Button x:Name="RelocateFolderButton" Content="Chọn vị trí thư mục đã chuyển" Click="SelectMovedFolder" HorizontalAlignment="Left" Visibility="Collapsed"/>
    <TextBlock x:Name="MissingLocalNote" TextWrapping="Wrap" Foreground="#9C5C10" Margin="0,6,0,10" Visibility="Collapsed"/>
    <CheckBox x:Name="DeleteSheetBox" Content="Xóa cả dòng đã ghi vào Google Sheets" Margin="0,6"/>
    <TextBlock x:Name="KeepChannelNote" Text="Chỉ xóa dòng video; dòng trong Kênh nguồn được giữ." TextWrapping="Wrap" Foreground="#61748A" Margin="20,0,0,6" Visibility="Collapsed"/>
    <CheckBox x:Name="DeleteVideoBox" Content="Xóa video đã đăng trên YouTube" Margin="0,6"/>
    <CheckBox x:Name="RemoveHistoryBox" Content="Xóa công việc khỏi lịch sử (xóa hết kết quả hiện có)" Margin="0,12,0,6" Visibility="Collapsed"/>
    <TextBlock x:Name="UnknownUpload" Text="Upload chưa rõ kết quả và chưa có ID. Cần kiểm tra YouTube Studio; app chưa thể xác định video để xóa." TextWrapping="Wrap" Foreground="#9C5C10" Margin="0,10" Visibility="Collapsed"/>
    <TextBlock Text="Xóa thư mục/dòng/video không thể hoàn tác bằng app. Mục lịch sử chỉ biến mất khi đã xử lý xong các lựa chọn." TextWrapping="Wrap" Foreground="#61748A" Margin="0,14,0,18"/>
  </StackPanel></ScrollViewer></DockPanel>
</Window>
