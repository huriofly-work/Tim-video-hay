        </Grid>

        <Expander Visibility="{Binding UploadSelected, Converter={StaticResource BoolVisibility}}" x:Name="UploadOptions" Header="Tùy chọn đăng YouTube" Margin="0,0,0,12"><StackPanel Margin="0,10,0,0">

          <TextBlock Text="Tiêu đề riêng (để trống để dùng tên video)"/><TextBox Text="{Binding UploadTitle, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{Binding UploadTitleError}" Foreground="#B42318" TextWrapping="Wrap" Style="{StaticResource OptionalText}"/>

          <TextBlock Text="Mô tả (mặc định trống)"/><TextBox Text="{Binding UploadDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/><TextBlock Text="{Binding UploadDescriptionError}" Foreground="#B42318" TextWrapping="Wrap" Style="{StaticResource OptionalText}"/>

          <ComboBox ItemsSource="{Binding PrivacyOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Privacy}"/>

          <TextBlock Text="Luôn khai báo không dành cho trẻ em. Video được đăng theo chế độ bạn chọn." Foreground="#61748A" TextWrapping="Wrap"/>

        </StackPanel></Expander>

        </StackPanel></ScrollViewer></DockPanel></Expander></Border>

 <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><DockPanel Margin="0,0,0,6"><WrapPanel x:Name="HistoryToolbar" DockPanel.Dock="Right"><Button x:Name="RefreshHistoryButton" Content="Làm mới" ToolTip="Chỉ đọc lại lịch sử công việc trên máy; giữ bộ lọc và dòng đang chọn." Command="{Binding RefreshHistoryCommand}"/><Button x:Name="PauseAllHistoryButton" Content="Tạm dừng tất cả" Command="{Binding StopCommand}"/></WrapPanel><TextBlock x:Name="HistoryTitle" Text="Lịch sử công việc" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/></DockPanel>
