          <DataGridTemplateColumn Header="Thao tác" Width="200" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><WrapPanel><Button Content="{Binding PauseResumeLabel}" IsEnabled="{Binding CanTogglePause}" Visibility="{Binding CanTogglePause, Converter={StaticResource BoolVisibility}}" Click="PauseRow" Margin="0,0,3,0" Padding="4"/><Button Content="Bổ sung" ToolTip="Thực hiện phần chưa làm, phần đã xóa hoặc tải lại ảnh bìa" Visibility="{Binding CanSupplement, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanSupplement}" Click="AddRow" Margin="0" Padding="4"/><Button Content="Xóa" ToolTip="Chọn kết quả cần xóa hoặc xóa công việc khỏi lịch sử" Style="{StaticResource DangerQuiet}" Click="DeleteRow" Margin="3,0,0,0" Padding="4"/></WrapPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>

