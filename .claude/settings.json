{
  "permissions": {
    "ask": [
      "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Publish-Release.ps1:*)",
      "PowerShell(./scripts/Publish-Release.ps1:*)",
      "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File packaging/Install-Local.ps1:*)",
      "PowerShell(./packaging/Install-Local.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Publish-Release.ps1:*)",
      "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File packaging/Install-Local.ps1:*)"
    ],
    "deny": [
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Check-Ps1Encoding.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
